{
  "name": "demo-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Microteia extensions authored by this organization.",
  "dependencies": {
    "@microteia/sdk": "file:../.microteia/install/sdk/microteia-sdk.tgz"
  },
  "microteia": {
    "namespace": "br.com.microteia",
    "kernelVersion": "2.106.0",
    "publisher": "Microteia",
    "prefix": "pet"
  },
  "scripts": {
    "create": "microteia-plugin create",
    "create:function": "microteia-plugin create function",
    "check": "microteia-plugin check",
    "build": "microteia-plugin build",
    "check:all": "microteia-plugin check --all",
    "build:all": "microteia-plugin build --all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "microteia-plugin sync",
    "sdk:refresh": "npm install ../.microteia/install/sdk/microteia-sdk.tgz && microteia-plugin sync && npm install"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "sucrase": "^3.35.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
